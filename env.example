SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_REDIRECT_URL=https://your-site.com/auth/callback

# Resend email (optional but recommended for license delivery)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Reaper Script <you@example.com>"

# PayPal REST app (developer.paypal.com > Apps & Credentials). Required: /api/paypal/webhook checks
# every order with PayPal before it issues a key. PAYPAL_ENV=sandbox for test payments, otherwise live.
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENV=live

# Admin panel password (for testing/admin access)
ADMIN_PASSWORD=admin123




# Native plugin license tokens (FX Devices' CLAP plugins check these themselves): the Ed25519
# private key that signs them, as base64 PKCS8 DER. The plugins carry the matching public key, so
# changing it needs new plugin builds. Without it, plugins asking for a token get "try again later".
LICENSE_TOKEN_KEY=
